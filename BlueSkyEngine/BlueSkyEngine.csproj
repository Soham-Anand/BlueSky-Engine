<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>BlueSky.Editor.Program</StartupObject>
  </PropertyGroup>



  <ItemGroup>
    <PackageReference Include="JoltPhysicsSharp" Version="2.11.2" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeaScript\TeaScript.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Shaders\**\*.air" />
    <None Remove="Editor\Shaders\**\*.air" />
    <None Remove="Rendering\Shaders\**\*.air" />
    <None Remove="Rendering\EasePlus\Shaders\**\*.air" />
    <None Update="Shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Editor\Shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Editor\app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="roboto.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CompileMetalShaders" BeforeTargets="BeforeBuild" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">
    <Message Importance="High" Text="Compiling Metal Shaders..." />
    <!-- Viewport 3D -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.metallib&quot;" />
    
    <!-- Simple UI -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.metallib&quot;" />

    <!-- Horizon Lighting -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Editor/Shaders/horizon_lighting.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/horizon_lighting.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Editor/Shaders/horizon_lighting.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/horizon_lighting.metallib&quot;" />

    <!-- PBR Optimized -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Editor/Shaders/pbr_optimized.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/pbr_optimized.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Editor/Shaders/pbr_optimized.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/pbr_optimized.metallib&quot;" />

    <!-- Polaris Upscale -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Rendering/Shaders/PolarisUpscale.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Rendering/Shaders/PolarisUpscale.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Rendering/Shaders/PolarisUpscale.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/PolarisUpscale.metallib&quot;" />

    <!-- EasePlus PrePass -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_prepass.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_prepass.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_prepass.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/easeplus_prepass.metallib&quot;" />

    <!-- EasePlus Lighting -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_lighting.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_lighting.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_lighting.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/easeplus_lighting.metallib&quot;" />

    <!-- EasePlus Material -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_material.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_material.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_material.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/easeplus_material.metallib&quot;" />

    <!-- EasePlus Grid -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_grid.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_grid.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_grid.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/easeplus_grid.metallib&quot;" />

    <!-- EasePlus PostFX -->
    <Exec Command="xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_postfx.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_postfx.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0" />
    <Exec Command="xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders/easeplus_postfx.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/easeplus_postfx.metallib&quot;" />

    <!-- Copy compiled metallibs to Shaders folder so both copies are kept up-to-date -->
    <Exec Command="cp &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.metallib&quot; &quot;$(MSBuildProjectDirectory)/Shaders/viewport_3d.metallib&quot;" />
    <Exec Command="cp &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.metallib&quot; &quot;$(MSBuildProjectDirectory)/Shaders/simple_ui.metallib&quot;" />
    <Exec Command="cp &quot;$(MSBuildProjectDirectory)/Editor/Shaders/horizon_lighting.metallib&quot; &quot;$(MSBuildProjectDirectory)/Shaders/horizon_lighting.metallib&quot;" />
    <Exec Command="cp &quot;$(MSBuildProjectDirectory)/Editor/Shaders/pbr_optimized.metallib&quot; &quot;$(MSBuildProjectDirectory)/Shaders/pbr_optimized.metallib&quot;" />

    <!-- Cleanup air files -->
    <Exec Command="rm -f &quot;$(MSBuildProjectDirectory)/Editor/Shaders&quot;/*.air &quot;$(MSBuildProjectDirectory)/Rendering/EasePlus/Shaders&quot;/*.air &quot;$(MSBuildProjectDirectory)/Rendering/Shaders&quot;/*.air" />
  </Target>

</Project>
