<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>BlueSky.Editor.Program</StartupObject>
  </PropertyGroup>



  <ItemGroup>
    <PackageReference Include="JoltPhysicsSharp" Version="2.11.2" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <!-- EOS SDK native libraries -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="../ThirdParty/EOSSDK/SDK/Bin/libEOSSDK-Mac-Shipping.dylib" CopyToOutputDirectory="PreserveNewest" Link="libEOSSDK-Mac-Shipping.dylib" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="../ThirdParty/EOSSDK/SDK/Bin/EOSSDK-Win64-Shipping.dll" CopyToOutputDirectory="PreserveNewest" Link="EOSSDK-Win64-Shipping.dll" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="../ThirdParty/EOSSDK/SDK/Bin/libEOSSDK-Linux-Shipping.so" CopyToOutputDirectory="PreserveNewest" Link="libEOSSDK-Linux-Shipping.so" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeaScript\TeaScript.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Shaders\**\*.air" />
    <None Remove="Editor\Shaders\**\*.air" />
    <None Remove="BSR\Shaders\**\*.air" />
    <None Update="Shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Editor\Shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Editor\app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="roboto.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CompileMetalShaders" BeforeTargets="BeforeBuild" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">
    <Message Importance="High" Text="Checking / Compiling Metal Shaders..." />
    <Exec Command="if xcrun -sdk macosx -f metal &gt;/dev/null 2&gt;&amp;1; then xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0 &amp;&amp; xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/viewport_3d.metallib&quot; &amp;&amp; xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.metal&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0 &amp;&amp; xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/simple_ui.metallib&quot; &amp;&amp; xcrun -sdk macosx metal -c &quot;$(MSBuildProjectDirectory)/BSR/Shaders/PolarisUpscale.metal&quot; -o &quot;$(MSBuildProjectDirectory)/BSR/Shaders/PolarisUpscale.air&quot; -std=metal3.0 -O3 -ffast-math -mmacosx-version-min=11.0 &amp;&amp; xcrun -sdk macosx metallib &quot;$(MSBuildProjectDirectory)/BSR/Shaders/PolarisUpscale.air&quot; -o &quot;$(MSBuildProjectDirectory)/Editor/Shaders/PolarisUpscale.metallib&quot; &amp;&amp; rm -f &quot;$(MSBuildProjectDirectory)/Editor/Shaders&quot;/*.air &quot;$(MSBuildProjectDirectory)/BSR/Shaders&quot;/*.air; else echo &quot;  [Metal] CLI metal compiler not in PATH — runtime will compile .metal sources via Metal.framework&quot;; fi" />
  </Target>

</Project>
